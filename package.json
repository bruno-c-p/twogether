{
  "name": "twogether",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "NODE_ENV=development bun --bun vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "fitness": "bun scripts/fitness.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && files=$(find src -name '*.server.test.ts') && test -n \"$files\" && bun test $files",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:must": "playwright test --config e2e/playwright.config.ts e2e/specs/auth.spec.ts e2e/specs/household.spec.ts e2e/specs/accounts.spec.ts e2e/specs/transactions.spec.ts e2e/specs/overview-goals.spec.ts e2e/specs/chrome.spec.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-router": "1.170.36",
    "@tanstack/react-start": "1.168.53",
    "lucide-react": "^0.577.0",
    "nitro": "^3.0.260903-beta",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.57.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
