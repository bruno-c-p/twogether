{
  "name": "twogether",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "NODE_ENV=development bun --bun vite --host 0.0.0.0 --port 3000",
    "build": "bun scripts/check-env.ts && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "fitness": "bun scripts/fitness.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && files=$(find src -name '*.server.test.ts') && test -n \"$files\" && bun test $files",
    "e2e": "playwright test --config e2e/playwright.config.ts"
  },
  "dependencies": {
    "@clerk/localizations": "^4.17.1",
    "@clerk/tanstack-react-start": "^1.5.15",
    "@libsql/client": "^0.18.0",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-router": "1.170.36",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.168.53",
    "lucide-react": "^0.577.0",
    "nitro": "^3.0.260903-beta",
    "posthog-js": "^1.434.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@clerk/backend": "^3.18.1",
    "@clerk/testing": "^2.2.36",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.57.0",
    "unocss": "^66.10.5",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
