{
  "name": "twogether",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "NODE_ENV=development bun --bun vite --host 0.0.0.0 --port 3000",
    "build": "bun scripts/check-env.ts && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "fitness": "bun scripts/fitness.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && files=$(find src -name '*.server.test.ts') && test -n \"$files\" && bun test $files",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "doctor": "react-doctor --yes --verbose --blocking warning",
    "fallow": "vitest run --coverage --silent && fallow --format compact"
  },
  "dependencies": {
    "@clerk/localizations": "^4.17.1",
    "@clerk/tanstack-react-start": "^1.5.15",
    "@libsql/client": "^0.18.0",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-router": "1.170.36",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.168.53",
    "lucide-react": "^0.577.0",
    "posthog-js": "^1.434.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@clerk/backend": "^3.18.1",
    "@clerk/testing": "^2.2.36",
    "@oxlint/plugins": "1.85.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "dotenv": "^18.0.4",
    "fallow": "3.30.0",
    "jsdom": "^30.1.1",
    "nitro": "^3.0.260903-beta",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "^3.9.6",
    "react-doctor": "^0.9.14",
    "typescript": "^5.9.0",
    "unocss": "^66.10.5",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
