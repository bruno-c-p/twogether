{
  "name": "twogether",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "setup": "bun --no-env-file scripts/setup-worktree.ts",
    "dev": "NODE_ENV=development bun --bun vite --host 0.0.0.0 --port 3000",
    "dev:break-ui": "bun --bun vite --config tools/break-ui/vite.config.ts",
    "build": "bun scripts/check-env.ts && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:glaze": "eslint -c glaze.eslint.config.mjs --ignore-pattern '.output/**' .",
    "fitness": "bun scripts/fitness.ts",
    "merge-guard": "bun scripts/merge-guard.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && files=$(find src -name '*.server.test.ts') && test -n \"$files\" && bun test $files",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "doctor": "react-doctor --yes --verbose --blocking warning",
    "fallow": "vitest run --coverage --silent && fallow --format compact --baseline scripts/boundary-baseline.json --fail-on-stale-baseline"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@clerk/localizations": "^4.17.1",
    "@clerk/mcp-tools": "^0.6.0",
    "@clerk/shared": "^4.33.0",
    "@clerk/tanstack-react-start": "^1.5.15",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.168.60",
    "big.js": "^7.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "nuqs": "2.10.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "7.89.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@clerk/backend": "^3.18.1",
    "@clerk/testing": "^2.2.36",
    "@oxlint/plugins": "1.85.0",
    "@playwright/test": "^1.63.0",
    "@tanstack/start-storage-context": "1.167.36",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/big.js": "^7.0.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "dotenv": "^18.0.4",
    "eslint": "^9.39.5",
    "fallow": "3.30.0",
    "jsdom": "^30.1.1",
    "nitro": "^3.0.260903-beta",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "^3.9.6",
    "react-doctor": "^0.9.14",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
