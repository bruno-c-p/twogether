{
  "$schema": "https://react.doctor/schema/config.json",
  "blocking": "warning",
  "ignore": {
    "files": [
      ".output/**",
      ".tanstack/**",
      ".vercel/**",
      "dist/**",
      ".agents/**",
      ".claude/**",
      ".factory/**",
      ".goose/**",
      ".kiro/**",
      ".qwen/**",
      "tools/**",
      "src/components/glaze/**",
      "src/lib/glaze/**"
    ],
    "overrides": [
      {
        // These mutations hold no query data. Server actions refresh what
        // they change with router.invalidate(), which reruns the route
        // loaders (the rule only counts queryClient calls); the invite copy
        // writes to the clipboard; the break-ui fixture echoes a string.
        "files": [
          "src/features/auth/hooks/use-action-run.ts",
          "src/features/auth/components/account-settings.tsx",
          "src/features/break-ui/main.tsx"
        ],
        "rules": ["react-doctor/query-mutation-missing-invalidation"]
      },
      {
        // The month-load mutation fills the workspace cache through
        // queryClient.query() before the URL changes; it writes nothing the
        // cache would need to refetch.
        "files": ["src/features/budget/hooks/use-workspace-search.ts"],
        "rules": ["react-doctor/query-mutation-missing-invalidation"]
      },
      {
        // navigate() runs inside useBrowserSync's callback, which React Query
        // calls once after hydration, never during render.
        "files": ["src/routes/_authenticated/_workspace/route.tsx"],
        "rules": ["react-doctor/tanstack-start-no-navigate-in-render"]
      },
      {
        // The test harness replays a user story against a single in-memory
        // SQLite connection, so its steps run in order on purpose.
        "files": ["src/server/store-test-harness.ts"],
        "rules": ["react-doctor/server-sequential-independent-await"]
      },
      {
        // An MCP write runs the tool's own checks, then the setup gate and
        // rate limit, then validation, in that order: running them together
        // would spend a rate-limit token on a call the checks reject and
        // answer a user without setup with a validation error.
        "files": ["src/features/mcp/write-tool.server.ts"],
        "rules": ["react-doctor/server-sequential-independent-await"]
      }
    ]
  }
}
