# Somente no servidor. Copie para .env.local e preencha.
RESEND_API_KEY=
# Endereço de um domínio verificado no Resend
RESEND_FROM="Twogether <acesso@seu-dominio.com>"
# URL que ambos conseguem acessar; HTTPS em produção
APP_ORIGIN=http://localhost:3000
# Disco persistente para o banco compartilhado
BUDGET_DATABASE_PATH=./data/twogether.sqlite
