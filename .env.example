# Server-only. Copy to .env.local and fill in the values.
# Clerk development keys; `npx clerk@latest init` writes them here.
# Claim the application with `npx clerk@latest auth login` before production.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Turso Cloud: filled by `vercel env pull` after the Vercel integration
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Local fallback when Turso variables are unset
BUDGET_DATABASE_PATH=./data/twogether.sqlite

# PostHog client analytics
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=<ph_project_token>
VITE_PUBLIC_POSTHOG_HOST=<ph_client_api_host>
