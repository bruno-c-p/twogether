# Server-only. Copy to .env.local and fill in the values.
RESEND_API_KEY=
# Address on a domain verified in Resend
RESEND_FROM="Twogether <acesso@seu-dominio.com>"
# URL both people can reach; HTTPS in production
APP_ORIGIN=http://localhost:3000
# Turso Cloud: filled by `vercel env pull` after the Vercel integration
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Local fallback when Turso variables are unset
BUDGET_DATABASE_PATH=./data/twogether.sqlite
