{
  // This file is JSONC: fallow reads these comments; generic JSON tools may not.
  "$schema": "./node_modules/fallow/schema.json",
  // TanStack Start loads src/start.ts by convention; nothing imports it.
  "entry": [
    "src/start.ts",
    // The separate dev Vite server loads this HTML entry and substitutes these
    // modules through aliases; none belongs to the production route tree.
    "tools/break-ui/entry.ts",
    "src/features/break-ui/actions.ts",
    "src/features/break-ui/clerk.ts"
  ],
  // Vendored upstream code keeps its own shape (see tools/oxlint/anti-slop/UPSTREAM.md).
  // It stays in the graph so its @oxlint/plugins import counts as a use.
  "ignoreFindings": ["tools/oxlint/anti-slop/**"],
  "health": {
    // Vendored upstream code keeps its own shape.
    "ignore": ["tools/oxlint/anti-slop/**"],
    // Measured Vitest coverage; `bun run fallow` regenerates it first.
    "coverage": "coverage/coverage-final.json"
  },
  "duplicates": {
    // Hide pair-only clones; focus on widespread copy-paste
    // worth refactoring. Lower to 2 to report every duplicate pair.
    "minOccurrences": 3
  },
  "rules": {
    "unused-dependencies": "warn"
  },
  // First matching zone wins, so each feature's public zones (*-store, *-api)
  // precede its internals. Older violations live in
  // scripts/boundary-baseline.json.
  "boundaries": {
    "zones": [
      // The composition root: the only code that may import feature stores,
      // and only through each feature's *.server.ts entry point.
      {
        "name": "store",
        "patterns": [
          "src/server/store.server.ts",
          "src/server/middleware.ts",
          "src/server/serve.server.ts",
          "src/server/store-test-harness.ts"
        ]
      },
      {
        "name": "auth-store",
        "patterns": ["src/features/auth/auth.server.ts"]
      },
      {
        "name": "household-store",
        "patterns": ["src/features/household/household.server.ts"]
      },
      {
        "name": "budget-store",
        "patterns": ["src/features/budget/budget.server.ts"]
      },
      {
        "name": "budget-domain",
        "patterns": ["src/features/budget/domain/**"]
      },
      // A feature's public API: index.ts for functions and types, plus the
      // component modules routes or other features render. They stay
      // separate modules so a lazy route chunk does not pull a barrel's other
      // components in with it. budget/registry.ts likewise keeps the mutation
      // registry out of the eager index.ts chunk. Every export of a listed
      // module is public.
      {
        "name": "budget-api",
        "patterns": [
          "src/features/budget/index.ts",
          "src/features/budget/registry.ts",
          "src/features/budget/components/budget-app/budget-app.tsx",
          "src/features/budget/components/screens/*.tsx",
          "src/features/budget/components/workspace-skeleton.tsx"
        ]
      },
      {
        "name": "theme-api",
        "patterns": [
          "src/features/theme/index.ts",
          "src/features/theme/components/theme-toggle/theme-toggle.tsx"
        ]
      },
      {
        "name": "auth-api",
        "patterns": [
          "src/features/auth/index.ts",
          "src/features/auth/components/account-drawer.tsx",
          "src/features/auth/components/account-gate/account-gate.tsx"
        ]
      },
      {
        "name": "household-api",
        "patterns": [
          "src/features/household/index.ts",
          "src/features/household/components/member-list/member-list.tsx"
        ]
      },
      // The MCP feature's public surface is its HTTP endpoint module.
      {
        "name": "mcp-api",
        "patterns": ["src/features/mcp/endpoint.server.ts"]
      },
      { "name": "auth", "patterns": ["src/features/auth/**"] },
      { "name": "break-ui", "patterns": ["src/features/break-ui/**"] },
      { "name": "budget", "patterns": ["src/features/budget/**"] },
      { "name": "household", "patterns": ["src/features/household/**"] },
      { "name": "mcp", "patterns": ["src/features/mcp/**"] },
      { "name": "theme", "patterns": ["src/features/theme/**"] },
      { "name": "server", "patterns": ["src/server/**"] },
      { "name": "lib", "patterns": ["src/lib/**"] },
      { "name": "components", "patterns": ["src/components/**"] },
      {
        "name": "app",
        "patterns": [
          "src/routes/**",
          "src/router.tsx",
          "src/start.ts",
          "src/start.server.test.ts"
        ]
      }
    ],
    "rules": [
      {
        "from": "store",
        "allow": [
          "auth-store",
          "household-store",
          "budget-store",
          "server",
          "lib"
        ]
      },
      { "from": "auth-store", "allow": ["server", "lib"] },
      { "from": "household-store", "allow": ["server", "lib"] },
      {
        "from": "budget-store",
        "allow": ["budget-domain", "budget", "server", "lib"]
      },
      { "from": "budget-domain", "allow": ["lib"] },
      {
        "from": "budget-api",
        "allow": [
          "budget",
          "budget-domain",
          "theme-api",
          "server",
          "lib",
          "components"
        ]
      },
      {
        "from": "theme-api",
        "allow": ["theme", "budget-api", "server", "lib", "components"]
      },
      {
        "from": "auth-api",
        "allow": [
          "auth",
          "budget-api",
          "theme-api",
          "server",
          "lib",
          "components",
          "household-api"
        ]
      },
      {
        "from": "household-api",
        "allow": [
          "household",
          "budget-api",
          "theme-api",
          "server",
          "lib",
          "components"
        ]
      },
      {
        "from": "mcp-api",
        "allow": [
          "mcp",
          "budget-api",
          "theme-api",
          "store",
          "server",
          "lib",
          "components"
        ]
      },
      {
        "from": "budget",
        "allow": [
          "budget-domain",
          "budget-api",
          "theme-api",
          "store",
          "server",
          "lib",
          "components"
        ]
      },
      {
        "from": "auth",
        "allow": [
          "budget-api",
          "household-api",
          "theme-api",
          "store",
          "server",
          "lib",
          "components",
          "auth-api"
        ]
      },
      {
        // The dev-only fake stands in for every feature's actions barrel, so it
        // reads each feature's actions type.
        "from": "break-ui",
        "allow": [
          "budget-api",
          "auth-api",
          "household-api",
          "theme-api",
          "server",
          "lib",
          "components"
        ]
      },
      {
        "from": "household",
        "allow": [
          "budget-api",
          "theme-api",
          "store",
          "server",
          "lib",
          "components",
          "household-api"
        ]
      },
      {
        "from": "mcp",
        "allow": [
          "budget-api",
          "mcp-api",
          "theme-api",
          "store",
          "server",
          "lib",
          "components"
        ]
      },
      {
        "from": "theme",
        "allow": ["budget-api", "theme-api", "server", "lib", "components"]
      },
      {
        "from": "app",
        "allow": [
          "budget-api",
          "auth-api",
          "mcp-api",
          "theme-api",
          "store",
          "server",
          "lib",
          "components"
        ]
      },
      { "from": "server", "allow": ["lib", "components"] },
      { "from": "lib", "allow": ["server", "components"] },
      { "from": "components", "allow": ["server", "lib"] }
    ]
  }
}
