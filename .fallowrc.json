{
  // This file is JSONC: fallow reads these comments; generic JSON tools may not.
  "$schema": "./node_modules/fallow/schema.json",
  // TanStack Start loads src/start.ts by convention; nothing imports it.
  "entry": [
    "src/start.ts",
    // The separate dev Vite server loads this HTML entry and substitutes these
    // modules through aliases; none belongs to the production route tree.
    "tools/break-ui/entry.ts",
    "src/features/break-ui/actions.ts",
    "src/features/break-ui/clerk.ts"
  ],
  // Vendored upstream code keeps its own shape (see tools/oxlint/anti-slop/UPSTREAM.md).
  // It stays in the graph so its @oxlint/plugins import counts as a use.
  "ignoreFindings": ["tools/oxlint/anti-slop/**"],
  "health": {
    // Vendored upstream code keeps its own shape.
    "ignore": ["tools/oxlint/anti-slop/**"],
    // Measured Vitest coverage; `bun run fallow` regenerates it first.
    "coverage": "coverage/coverage-final.json"
  },
  "duplicates": {
    // Hide pair-only clones; focus on widespread copy-paste
    // worth refactoring. Lower to 2 to report every duplicate pair.
    "minOccurrences": 3
  },
  "rules": {
    "unused-dependencies": "warn"
  },
  // First matching zone wins, so each feature's index.ts zone precedes its
  // internals. Older violations live in scripts/boundary-baseline.json.
  "boundaries": {
    "zones": [
      {
        "name": "budget-domain",
        "patterns": ["src/features/budget/domain/**"]
      },
      { "name": "budget-api", "patterns": ["src/features/budget/index.ts"] },
      { "name": "theme-api", "patterns": ["src/features/theme/index.ts"] },
      { "name": "auth", "patterns": ["src/features/auth/**"] },
      { "name": "break-ui", "patterns": ["src/features/break-ui/**"] },
      { "name": "budget", "patterns": ["src/features/budget/**"] },
      { "name": "household", "patterns": ["src/features/household/**"] },
      { "name": "mcp", "patterns": ["src/features/mcp/**"] },
      { "name": "theme", "patterns": ["src/features/theme/**"] },
      { "name": "server", "patterns": ["src/server/**"] },
      { "name": "lib", "patterns": ["src/lib/**"] },
      { "name": "components", "patterns": ["src/components/**"] },
      {
        "name": "app",
        "patterns": ["src/routes/**", "src/router.tsx", "src/start.ts"]
      }
    ],
    "rules": [
      { "from": "budget-domain", "allow": ["lib"] },
      {
        "from": "budget-api",
        "allow": ["budget", "theme-api", "server", "lib", "components"]
      },
      {
        "from": "theme-api",
        "allow": ["theme", "budget-api", "server", "lib", "components"]
      },
      {
        "from": "budget",
        "allow": [
          "budget-domain",
          "budget-api",
          "theme-api",
          "server",
          "lib",
          "components"
        ]
      },
      {
        "from": "auth",
        "allow": ["budget-api", "theme-api", "server", "lib", "components"]
      },
      {
        "from": "break-ui",
        "allow": ["budget-api", "theme-api", "server", "lib", "components"]
      },
      {
        "from": "household",
        "allow": ["budget-api", "theme-api", "server", "lib", "components"]
      },
      {
        "from": "mcp",
        "allow": ["budget-api", "theme-api", "server", "lib", "components"]
      },
      {
        "from": "theme",
        "allow": ["budget-api", "theme-api", "server", "lib", "components"]
      },
      {
        "from": "app",
        "allow": ["budget-api", "theme-api", "server", "lib", "components"]
      },
      { "from": "server", "allow": ["lib", "components"] },
      { "from": "lib", "allow": ["server", "components"] },
      { "from": "components", "allow": ["server", "lib"] }
    ]
  }
}
